# Required for the HTTP API (Bearer token). Generate a long random string.
APP_VALIDATOR_API_TOKEN=replace-with-a-long-random-token

# Optional bind address (default 127.0.0.1:8788)
APP_VALIDATOR_API_HOST=127.0.0.1
APP_VALIDATOR_API_PORT=8788

# Optional app-under-test login (referenced by login.username_env / password_env)
# Never commit real values. Prefer these over JSON body passwords.
MIZZOU_USER=
MIZZOU_PASSWORD=

# Headed Chrome for SPA/CDP (default 1). Set 0/false/headless to disable.
# APP_VALIDATOR_HEADED=1

# Optional Chrome path (.app bundle or binary)
# CHROME_PATH=/Applications/Google Chrome.app
